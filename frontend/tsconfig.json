{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Mirrored here so tooling that reads only the root tsconfig (e.g. the
  // shadcn CLI) resolves the @/* alias to src/.
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
