# --- Supabase (authentication provider) ---
# Project Settings → API → Project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=
# Project Settings → API → Publishable key (`sb_publishable_...`, the new
# name for the anon/public key). Public by design — safe for the browser.
VITE_SUPABASE_ANON_KEY=

# --- Backend API ---
VITE_API_URL=http://localhost:8000
