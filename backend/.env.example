# Application
APP_NAME=Accessibility Remediation API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server
# CORS origins the API will accept (comma-separated).
CORS_ORIGINS=http://localhost:5173

# --- Supabase (authentication provider) ---
# Project Settings → API → Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
# Project Settings → API → Secret key (service_role / `sb_secret_...`).
# Backend-only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: access tokens are verified asymmetrically against the project's JWKS
# endpoint (SUPABASE_URL/auth/v1/.well-known/jwks.json) — the legacy
# SUPABASE_JWT_SECRET / HS256 shared-secret approach is no longer used.

# --- LLM (strategy generation, Module 4) ---
# Provider used to generate candidate remediation strategies.
#   openai -> any OpenAI-compatible chat-completions endpoint (default)
#   mock   -> deterministic, clearly-labeled provider (tests/demos only)
LLM_PROVIDER=openai
# Model name for the chat-completions endpoint.
LLM_MODEL=gpt-4o-mini
# Backend-only API key. Never expose this to the frontend.
# Leave empty when LLM_PROVIDER=mock or to make the strategy API fail
# gracefully (503) instead of faking a generation.
LLM_API_KEY=
# Base URL of an OpenAI-compatible endpoint (OpenAI, Azure, local gateway).
LLM_BASE_URL=https://api.openai.com/v1
# Sampling temperature for strategy generation.
LLM_TEMPERATURE=0.2
# Upper bound on completion tokens.
LLM_MAX_TOKENS=3000
# Request timeout in seconds.
LLM_TIMEOUT_SECONDS=60.0
