# Application
APP_NAME=Accessibility Remediation API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server
# CORS origins the API will accept (comma-separated).
CORS_ORIGINS=http://localhost:5173

# --- Supabase (authentication provider) ---
# Project Settings → API → Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
# Project Settings → API → Secret key (service_role / `sb_secret_...`).
# Backend-only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: access tokens are verified asymmetrically against the project's JWKS
# endpoint (SUPABASE_URL/auth/v1/.well-known/jwks.json) — the legacy
# SUPABASE_JWT_SECRET / HS256 shared-secret approach is no longer used.
